            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v2/identities/:identifier/payment-request",
            "params": [
              {
                "name": "identifier",
                "value": "",
                "type": "path",
                "description": "Issuer identifier"
              },
              {
                "name": "userDID",
                "value": "",
                "type": "query",
                "description": "Filter by user DID"
              },
              {
                "name": "schemaID",
                "value": "",
                "type": "query",
                "description": "Filter by schema ID (schemas UUID)"
              },
              {
                "name": "nonce",
                "value": "",
                "type": "query",
                "description": "Filter by nonce"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Get payment requests for the provided identity."
        },
